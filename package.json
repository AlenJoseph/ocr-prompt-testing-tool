{
  "name": "ocr-prompt-testing-tool",
  "version": "1.0.0",
  "description": "A tool for testing and comparing OCR prompts with accuracy scoring using OpenAI API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "test": "npm run build && node dist/index.js test",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ocr",
    "testing",
    "openai",
    "prompt-engineering",
    "document-processing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^0.0.66",
    "ai": "^3.4.7",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "web-streams-polyfill": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}
