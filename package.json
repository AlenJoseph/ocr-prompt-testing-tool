  "description": "A tool for testing and comparing OCR prompts with accuracy scoring using OpenAI API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "test": "npm run build && node dist/index.js test",
    "dev": "ts-node src/index.ts",
